{
    "version": 3,
    "cmakeMinimumRequired": { "major": 3, "minor": 26, "patch": 0 },
    "configurePresets": [
        {
            "name": "win64",
            "displayName": "Windows x64 (MSVC v142 + Qt5)",
            "description": "生成器固定 VS2019：platform 子仓的 preset 硬编码 'Visual Studio 16 2019'，re 必须用同一个工具集(v142)才能链接平台产物。Qt 路径优先取环境变量 QTDIR，没设就用 cmake\\istar_common.cmake 里探测的常见位置 —— 换电脑不需要改任何文件。",
            "generator": "Visual Studio 16 2019",
            "architecture": "x64",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "CMAKE_PREFIX_PATH": "$env{QTDIR}"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "release",
            "configurePreset": "win64",
            "configuration": "Release",
            "jobs": 8
        },
        {
            "name": "debug",
            "configurePreset": "win64",
            "configuration": "Debug",
            "jobs": 8
        }
    ]
}
